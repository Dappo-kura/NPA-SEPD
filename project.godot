; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="整理パズル型サバイバル"
config/description="五日間の封印作業を生き延びろ"
run/main_scene="res://scenes/title_screen/title_screen.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.png"

[autoload]

GameManager="*res://autoload/game_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
ScenarioManager="*res://autoload/scenario_manager.gd"
UIFont="*res://autoload/ui_font.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/initial_position_type=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
